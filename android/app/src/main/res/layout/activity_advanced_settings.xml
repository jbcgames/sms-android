<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121218"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Ajustes Avanzados"
            android:textColor="#FFCC00"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Configura la calidad gráfica y optimizaciones para tu dispositivo"
            android:textColor="#E0E0E0"
            android:textSize="13sp" />

        <!-- Quick Presets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Perfiles Rápidos"
            android:textColor="#80D8FF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPresetLow"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#D32F2F"
                android:text="🚀 Bajo"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPresetBalanced"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#F57C00"
                android:text="⚖️ Medio"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPresetHigh"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#388E3C"
                android:text="✨ Alto"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPresetUltra"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#7B1FA2"
                android:text="💎 Ultra"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Settings Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E1E2C"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Render Scale -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escala de Renderizado (Hasta 8x)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spRenderScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#2A2A3C"
                android:padding="8dp" />

            <!-- FPS Target -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tasa de Fotogramas (FPS)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spFrameRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#2A2A3C"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvFrameRateNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="⚠️ 60 FPS exige alto rendimiento de procesador y GPU (30 FPS es lo recomendado para dispositivos gama media/baja)."
                android:textColor="#FFB74D"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Widescreen & Aspect Ratio Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Formato de Pantalla &amp; Widescreen"
                android:textColor="#80D8FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Widescreen Mode -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Relación de Aspecto (Widescreen)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spWidescreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#2A2A3C"
                android:padding="8dp" />

            <!-- HUD Position -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Posición de Interfaz / HUD en Widescreen"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spWidescreenHud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#2A2A3C"
                android:padding="8dp" />

            <!-- Aspect Scaling -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Escalado de Pantalla (Aspect)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spAspect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#2A2A3C"
                android:padding="8dp" />

            <!-- Draw Distance -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Distancia de Visión (Hasta 5x)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spDrawDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#2A2A3C"
                android:padding="8dp" />

            <!-- MSAA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Antialiasing (MSAA)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spMsaa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#2A2A3C"
                android:padding="8dp" />

            <!-- Anisotropic -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Filtro Anisotrópico"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spAniso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#2A2A3C"
                android:padding="8dp" />

            <!-- Low-End Mod Switches -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Optimizaciones de Rendimiento / Gráficos"
                android:textColor="#FFD54F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swDisableShadows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="4dp"
                android:showText="false"
                android:textColor="#FFFFFF"
                android:textOff=""
                android:textOn=""
                android:textSize="14sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swDisableReflections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="4dp"
                android:showText="false"
                android:textColor="#FFFFFF"
                android:textOff=""
                android:textOn=""
                android:textSize="14sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swDisableWaterAnim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="4dp"
                android:showText="false"
                android:textColor="#FFFFFF"
                android:textOff=""
                android:textOn=""
                android:textSize="14sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swDisableShimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="4dp"
                android:showText="false"
                android:textColor="#FFFFFF"
                android:textOff=""
                android:textOn=""
                android:textSize="14sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swFxaa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="4dp"
                android:showText="false"
                android:textColor="#FFFFFF"
                android:textOff=""
                android:textOn=""
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#455A64"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Cancelar"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#2E7D32"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="💾 Guardar Ajustes"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
